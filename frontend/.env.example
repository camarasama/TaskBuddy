# TaskBuddy Frontend Environment Variables

# API URL (defaults to /api/v1 if not set - uses Next.js rewrites)
# Production: set to the absolute API origin so the browser calls it directly,
# e.g. https://api.gettaskbuddy.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Target the Next.js rewrites proxy forwards /api and /uploads to (server-side).
# Production: https://api.gettaskbuddy.com
BACKEND_URL=http://localhost:3001

# Web Push (VAPID) — must match VAPID_PUBLIC_KEY in backend/.env
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Monitoring (Sentry) — leave NEXT_PUBLIC_SENTRY_DSN empty to disable Sentry (browser + server)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Environment
NODE_ENV=development
