# Compiled output must never live beside its source. shared/ used to emit in place, and the
# resulting .d.ts got committed and then drifted -- api.d.ts still declared AuthTokens.refreshToken
# long after F-2 removed it. tsc now emits to shared/dist (gitignored above); these patterns stop
# a stale in-place build from being committed again.
shared/src/**/*.js
shared/src/**/*.js.map
shared/src/**/*.d.ts
shared/src/**/*.d.ts.map

# Local AI tooling / memory (carried manually via USB, not via git) - mirrors GNFS
.mcp.json
.swarm/
.claude/
.claude-flow/
.agents/
ruvector.db
**/ruvector.db
agentdb.rvf
agentdb.rvf.lock

# Ruflo runtime artifacts (not part of the app; carried manually, not via git)
.ruflo/
.ruflo-memory-backup-*/
state.json

# ── Firebase / FCM credentials (added 2026-08-11) ────────────────────────────
# ⚠️ THIS REPO IS PUBLIC. Neither of these may ever be committed.
#
# The service account key is a genuine secret: it can send push as this project and read Firebase
# resources. If it is ever committed, rotating it in the Firebase console is the only fix — removing
# the commit is not enough, because the history is already public.
#
# google-services.json is not a secret in the strict sense (it ships inside every APK), but in a
# public repo it advertises the project and its API key, so it is supplied to EAS as a file-type
# environment variable instead of being committed.
mobile/google-services.json
mobile/*firebase-adminsdk*.json
**/*-firebase-adminsdk-*.json
