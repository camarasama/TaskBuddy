[Unit]
Description=Email alert when %i fails
# Templated OnFailure handler: %i is the failed unit's name (e.g. taskbuddy-backup.service).
# Wired up via `OnFailure=taskbuddy-backup-notify@%n.service` in the units it guards.

[Service]
Type=oneshot
# SMTP_* + ALERT_EMAIL live alongside the backup creds (chmod 600, root-owned, never committed).
EnvironmentFile=/opt/taskbuddy/backup.env
# Prefer the app's own Node (/opt/nodejs/lts, a symlink to the current LTS); root's default PATH
# resolves /usr/bin/node (v20, GNFS's). /opt/nodejs/22 stays second for a rollback window; if both
# are absent, `env node` falls through to /usr/bin.
# Keep the sbin directories — root's default PATH includes them and tools live there.
Environment=PATH=/opt/nodejs/lts/bin:/opt/nodejs/22/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Runs as root so it can read the journal for %i and the root-owned backup.env.
ExecStart=/usr/bin/env node /opt/taskbuddy/app/scripts/notify-failure.mjs %i
