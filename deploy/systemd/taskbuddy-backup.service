[Unit]
Description=TaskBuddy nightly Postgres backup to Cloudflare R2
After=network-online.target postgresql.service
Wants=network-online.target
# Email an alert (with the journal tail) if the backup fails. Instantiates
# taskbuddy-backup-notify@taskbuddy-backup.service.service (%n = this unit's name).
OnFailure=taskbuddy-backup-notify@%n.service

[Service]
Type=oneshot
# Credentials for the private backups bucket (never committed). chmod 600, root-owned.
EnvironmentFile=/opt/taskbuddy/backup.env
# Deliberately NO Environment=PATH here. backup-db.sh resolves /opt/nodejs/22/bin/node itself, so
# overriding PATH buys nothing — and an incomplete one breaks the script: `runuser` lives in
# /usr/sbin, which root's default PATH includes but a hand-written PATH easily omits.
ExecStart=/opt/taskbuddy/app/scripts/backup-db.sh
# Runs as root so it can pg_dump via the postgres peer account and read backup.env.
