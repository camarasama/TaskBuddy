{
  "name": "taskbuddy",
  "version": "1.0.0",
  "private": true,
  "description": "Family task management PWA with gamification for children ages 10-16",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm -w backend run dev",
    "dev:frontend": "npm -w frontend run dev",
    "dev:mobile": "npm -w mobile run start",
    "build": "npm run db:generate && npm run build:backend && npm run build:frontend",
    "build:backend": "npm -w backend run build",
    "build:frontend": "npm -w frontend run build",
    "lint": "npm run lint:backend && npm run lint:frontend && npm run lint:mobile",
    "typecheck:mobile": "npm -w mobile run typecheck",
    "lint:backend": "npm -w backend run lint",
    "lint:frontend": "npm -w frontend run lint",
    "lint:mobile": "npm -w mobile run lint",
    "test": "npm run test:backend && npm run test:frontend && npm run test:mobile",
    "test:backend": "npm -w backend run test",
    "test:frontend": "npm -w frontend run test",
    "test:mobile": "npm -w mobile run test",
    "db:migrate": "npm -w backend run db:migrate",
    "db:seed": "npm -w backend run db:seed",
    "db:studio": "npm -w backend run db:studio",
    "db:generate": "npm -w backend run db:generate",
    "postinstall": "npm -w backend run db:generate",
    "build:marketing": "node marketing/build.mjs"
  },
  "workspaces": [
    "backend",
    "frontend",
    "shared",
    "mobile"
  ],
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "marked": "^18.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "autoskills": "^0.2.3"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "postcss": "^8.5.23"
  }
}
