# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/taskbuddy

# ── Redis (optional — NOT used at launch, single instance) ───────────────────
# Left unset in production. Only needed if multi-instance scaling is added later.
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-another-random-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_CHILD_ACCESS_EXPIRES_IN=24h
JWT_CHILD_REFRESH_EXPIRES_IN=90d

# ── Auth ──────────────────────────────────────────────────────────────────────
ADMIN_INVITE_CODE=change-me
INVITE_TOKEN_EXPIRES_HOURS=72

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Mobile clients (P0-2) ─────────────────────────────────────────────────────
# Oldest native build allowed to run. GET /meta/min-version compares the app's X-Client version
# against these; below the floor the app shows a blocking upgrade screen. 0.0.0 blocks nothing —
# only raise these to retire a broken release without waiting on a store rollout.
MOBILE_MIN_VERSION_ANDROID=0.0.0
MOBILE_MIN_VERSION_IOS=0.0.0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allow cross-origin cookies (set true for production with separate domains)
CROSS_ORIGIN_COOKIES=false
# Comma-separated ngrok URLs for tunnelling during development
ALLOWED_NGROK_URL=

# ── SMTP (Nodemailer) ─────────────────────────────────────────────────────────
# Port 465 = implicit TLS (recommended). Port 587 = STARTTLS (broken on nodemailer v8).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-app-password
SMTP_FROM=TaskBuddy <your-email@yourdomain.com>

# ── Monitoring (Sentry) ───────────────────────────────────────────────────────
# Leave SENTRY_DSN empty to disable Sentry entirely (no events sent).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# ── File storage ──────────────────────────────────────────────────────────────
# STORAGE_PROVIDER=local  (default — files saved to ./uploads)
# STORAGE_PROVIDER=r2     (Cloudflare R2)
STORAGE_PROVIDER=local
UPLOADS_BASE_PATH=./uploads

# Cloudflare R2 (only required when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=taskbuddy-uploads
R2_PUBLIC_URL=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate keys once: cd backend && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@yourdomain.com

# ── Recurring tasks cron ──────────────────────────────────────────────────────
# Default: midnight UTC daily. Cron syntax.
RECURRING_CRON_SCHEDULE=0 0 * * *
