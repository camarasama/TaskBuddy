// TaskBuddy Database Schema
// Based on APP_DEVELOPMENT_INSTRUCTIONS.md v2.0

generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE TABLES
// ============================================

model Family {
  id                 String    @id @default(uuid())
  familyName         String    @map("family_name")
  familyCode         String?   @unique @map("family_code")
  /// U20 — cross-family referral (growth roadmap §7). DELIBERATELY NOT `familyCode`: that one admits
  /// a child to THIS family, and a referral code is meant to be posted publicly. Sharing one field
  /// for both would turn every shared referral link into an account-takeover vector.
  referralCode       String?   @unique @map("referral_code")
  /// The family whose code was used at registration. Write-once at signup, never updated.
  /// No child data participates in referral, which keeps acquisition outside the COPPA surface.
  referredByFamilyId String?   @map("referred_by_family_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  // M8 - Admin: allows admin to suspend a family (blocks all logins for that family)
  isSuspended        Boolean   @default(false) @map("is_suspended")
  suspendedAt        DateTime? @map("suspended_at")
  suspendedBy        String?   @map("suspended_by")

  // Relations
  users                User[]
  parentalConsent      ParentalConsent?
  taskTemplates        TaskTemplate[]
  tasks                Task[]
  rewards              Reward[]
  dailyChallenges      DailyChallenge[]
  settings             FamilySettings?
  invitations          FamilyInvitation[]
  emailLogs            EmailLog[]
  webhookSubscriptions WebhookSubscription[]
  transitions          AccountTransition[]

  @@map("families")
}

model User {
  id                         String    @id @default(uuid())
  familyId                   String?   @map("family_id")
  email                      String?   @unique
  /// Child login handle. Mandatory for children (enforced at the API boundary — see
  /// routes/family.ts and AuthService.addChild), null for parents and admins, who sign in with
  /// email. Uniqueness is scoped to the family by @@unique below, so two families may each have
  /// a `sam`. Always stored lowercased.
  username                   String?
  passwordHash               String?   @map("password_hash")
  role                       UserRole
  firstName                  String    @map("first_name")
  lastName                   String    @map("last_name")
  avatarUrl                  String?   @map("avatar_url")
  gender                     String?   @map("gender")
  isPrimaryParent            Boolean   @default(false) @map("is_primary_parent")
  dateOfBirth                DateTime? @map("date_of_birth") @db.Date
  phone                      String?
  isActive                   Boolean   @default(true) @map("is_active")
  lockedUntil                DateTime? @map("locked_until")
  failedLoginAttempts        Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt          DateTime? @map("last_failed_login_at")
  lastLoginAt                DateTime? @map("last_login_at")
  emailVerifiedAt            DateTime? @map("email_verified_at")
  emailVerificationToken     String?   @unique @map("email_verification_token")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")
  passwordResetTokenHash     String?   @map("password_reset_token_hash")
  passwordResetExpiresAt     DateTime? @map("password_reset_expires_at")
  mfaSecret                  String?   @map("mfa_secret") // F-9: AES-256-GCM encrypted TOTP secret (admins)
  mfaEnabledAt               DateTime? @map("mfa_enabled_at") // set once the first valid code is verified
  /// Quiet hours (growth roadmap §6, and the §11 binding guardrail "quiet hours respected in push
  /// scheduling"). HH:MM in the FAMILY's timezone, not UTC — see QuietHoursService. Suppresses the
  /// web push only; the in-app notification is still written. Off by default, so this ships silent.
  quietHoursEnabled          Boolean   @default(false) @map("quiet_hours_enabled")
  quietHoursStart            String    @default("20:00") @map("quiet_hours_start")
  quietHoursEnd              String    @default("07:00") @map("quiet_hours_end")
  /// Schooltime mode — a second window that applies only on the selected weekdays.
  schooltimeEnabled          Boolean   @default(false) @map("schooltime_enabled")
  schooltimeStart            String    @default("08:30") @map("schooltime_start")
  schooltimeEnd              String    @default("15:30") @map("schooltime_end")
  /// ISO weekday numbers, 1 = Monday .. 7 = Sunday. Defaults to the school week.
  schooltimeDays             Int[]     @default([1, 2, 3, 4, 5]) @map("schooltime_days")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  deletedAt                  DateTime? @map("deleted_at")

  // Relations
  family               Family?               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childProfile         ChildProfile?
  createdTasks         Task[]                @relation("CreatedTasks")
  taskAssignments      TaskAssignment[]      @relation("AssignedTasks")
  approvedAssignments  TaskAssignment[]      @relation("ApprovedAssignments")
  createdRewards       Reward[]
  rewardRedemptions    RewardRedemption[]
  rewardContributions  RewardContribution[]
  rewardWishlists      RewardWishlist[]
  cosmetics            ChildCosmetic[]
  taskComments         TaskComment[]
  childAchievements    ChildAchievement[]
  challengeCompletions ChallengeCompletion[]
  notifications        Notification[]
  pointsLedger         PointsLedger[]        @relation("ChildPoints")
  createdPointsEntries PointsLedger[]        @relation("CreatedPointsEntries")
  createdTemplates     TaskTemplate[]
  sentInvitations      FamilyInvitation[]    @relation("SentInvitations")
  emailLogs            EmailLog[]            @relation("ReceivedEmails")
  pushSubscriptions    PushSubscription[]
  gameSessions         GameSession[]
  gameQuestionsSeen    GameQuestionSeen[]
  refreshSessions      RefreshSession[]
  /// Set when a closed-test tester signs up with the email on their roster entry. See `Tester`.
  testerRecord         Tester?
  transition           AccountTransition?    @relation("TransitionChild")
  expoPushTokens       ExpoPushToken[]

  @@unique([familyId, username])
  @@index([familyId])
  @@index([email])
  @@index([role])
  @@index([username])
  @@map("users")
}

model ChildProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  dateOfBirth         DateTime  @map("date_of_birth") @db.Date
  ageGroup            AgeGroup? @map("age_group")
  pinHash             String?   @map("pin_hash")
  pointsBalance       Int       @default(0) @map("points_balance")
  totalPointsEarned   Int       @default(0) @map("total_points_earned")
  totalTasksCompleted Int       @default(0) @map("total_tasks_completed")
  currentStreakDays   Int       @default(0) @map("current_streak_days")
  longestStreakDays   Int       @default(0) @map("longest_streak_days")
  /// Streak insurance (growth roadmap §4.3). Earned one per 7-day milestone, capped at
  /// MAX_STREAK_FREEZES, and spent automatically to cover missed days rather than resetting.
  streakFreezes       Int       @default(0) @map("streak_freezes")
  /// Vacation mode (growth roadmap §11.2). An inclusive date range during which missed days do not
  /// count as a gap. Preserves the streak; it never advances it, or a holiday would out-earn a week
  /// of chores. Forward-only: a pause may not be opened over days already lost, because rebuilding a
  /// streak the child has already watched reset would rewrite a number they saw.
  ///
  /// Two nullable columns rather than a history table: one pause is live at a time, and a parent
  /// who wants a different range replaces it. Dates, not timestamps, because a holiday is a day.
  streakPausedFrom    DateTime? @map("streak_paused_from") @db.Date
  streakPausedUntil   DateTime? @map("streak_paused_until") @db.Date
  lastStreakDate      DateTime? @map("last_streak_date") @db.Date
  lastActivityDate    DateTime? @map("last_activity_date")
  level               Int       @default(1)
  experiencePoints    Int       @default(0) @map("experience_points")
  // M7 - CR-06: lifetime XP earned (never decremented - separate from spendable Points)
  totalXpEarned       Int       @default(0) @map("total_xp_earned")
  // M10 - Phase 5: selected emoji avatar from the avatar picker grid
  avatarEmoji         String?   @map("avatar_emoji")
  /// A photo the CHILD chose, held here until a parent approves it — only then is it copied to
  /// User.avatarUrl. Deliberately not written straight through: a photo is user-generated content
  /// visible to the whole family on an app for 10-16 year olds. The emoji picker is an allow-list
  /// for exactly that reason; a photo cannot be, so a parent is the gate instead.
  pendingAvatarUrl    String?   @map("pending_avatar_url")
  pendingAvatarAt     DateTime? @map("pending_avatar_at")
  /// Child-initiated PIN reset (mirrors User.passwordResetTokenHash / passwordResetExpiresAt for
  /// the parent flow). One column, not a token table: a fresh request overwrites the previous
  /// value, so an old emailed link is automatically invalidated the moment a new one is issued —
  /// there is never more than one valid token per child. Hashed at rest (sha256) so a DB leak
  /// does not hand out working reset links. Deliberately NOT unique — AuthService.requestChildPinReset
  /// runs an `updateMany` keyed on a fixed sentinel userId when no real child matches, so the write
  /// always executes with the same shape and cost whether or not the request was real.
  pinResetTokenHash   String?   @map("pin_reset_token_hash")
  pinResetExpiresAt   DateTime? @map("pin_reset_expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("child_profiles")
}

// ============================================
// TASK MANAGEMENT
// ============================================

model TaskTemplate {
  id                    String          @id @default(uuid())
  /// NULL for system templates (isSystemTemplate = true), which belong to no family.
  /// Required-and-cascading contradicted isSystemTemplate: a shipped template would have been owned
  /// by one family and hard-deleted along with them.
  familyId              String?         @map("family_id")
  name                  String
  description           String?
  category              String?
  difficulty            TaskDifficulty?
  suggestedPoints       Int             @default(10) @map("suggested_points")
  estimatedMinutes      Int?            @map("estimated_minutes")
  ageRange              String?         @map("age_range")
  requiresPhotoEvidence Boolean         @default(false) @map("requires_photo_evidence")
  isSystemTemplate      Boolean         @default(false) @map("is_system_template")
  createdBy             String?         @map("created_by")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  // Relations
  family  Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator User?   @relation(fields: [createdBy], references: [id])
  tasks   Task[]

  @@index([familyId])
  @@index([category])
  @@map("task_templates")
}

model Task {
  id                    String          @id @default(uuid())
  familyId              String          @map("family_id")
  templateId            String?         @map("template_id")
  createdBy             String          @map("created_by")
  title                 String
  description           String?
  category              String?
  difficulty            TaskDifficulty?
  // M5 - CR-01: primary = must-do, secondary = bonus/self-assignable
  taskTag               TaskTag         @default(primary) @map("task_tag")
  pointsValue           Int             @default(10) @map("points_value")
  dueDate               DateTime?       @map("due_date")
  // M5 - CR-09: optional scheduling fields for overlap detection
  startTime             DateTime?       @map("start_time")
  estimatedMinutes      Int?            @map("estimated_minutes")
  requiresPhotoEvidence Boolean         @default(false) @map("requires_photo_evidence")
  isRecurring           Boolean         @default(false) @map("is_recurring")
  recurrencePattern     String?         @map("recurrence_pattern")
  recurrenceConfig      Json?           @map("recurrence_config")
  autoApprove           Boolean         @default(false) @map("auto_approve")
  // How many different children can claim this task from the pool (null = unlimited)
  maxClaimsTotal        Int?            @map("max_claims_total")
  /// Team-up tasks (growth roadmap §6). Siblings share one task; each still earns the FULL base
  /// points — the bonus is on top, never a split, or teaming up would be worth less than working
  /// alone. Approval mechanics are unchanged; the bonus simply fires when the last member is
  /// approved, and is paid to every member.
  isTeamTask            Boolean         @default(false) @map("is_team_task")
  teamBonusPoints       Int             @default(0) @map("team_bonus_points")
  /// Exactly-once claim for the bonus payout (the FR-09 conditional-update pattern). Non-null means
  /// the bonus has already been paid; two parents approving the last two members concurrently must
  /// not double-pay.
  teamBonusAwardedAt    DateTime?       @map("team_bonus_awarded_at")
  status                TaskStatus      @default(active)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  deletedAt             DateTime?       @map("deleted_at")

  // Relations
  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  template    TaskTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  creator     User             @relation("CreatedTasks", fields: [createdBy], references: [id])
  assignments TaskAssignment[]

  @@index([familyId])
  @@index([dueDate])
  @@index([status])
  @@index([category])
  @@map("tasks")
}

model TaskAssignment {
  id                        String           @id @default(uuid())
  taskId                    String           @map("task_id")
  childId                   String           @map("child_id")
  instanceDate              DateTime         @map("instance_date") @db.Date
  status                    AssignmentStatus @default(pending)
  completedAt               DateTime?        @map("completed_at")
  approvedAt                DateTime?        @map("approved_at")
  approvedBy                String?          @map("approved_by")
  rejectionReason           String?          @map("rejection_reason")
  pointsAwarded             Int?             @map("points_awarded")
  xpAwarded                 Int?             @map("xp_awarded")
  // M9 - legacy single-send flag (superseded by expiryRemindersSent)
  emailSentAt               DateTime?        @map("email_sent_at")
  // Comma-separated list of reminder thresholds already sent, e.g. "24h,12h,1h,30min"
  expiryRemindersSent       String           @default("") @map("expiry_reminders_sent")
  // PD - time tracking for auto-approve override
  startedAt                 DateTime?        @map("started_at")
  autoApproveOverridden     Boolean          @default(false) @map("auto_approve_overridden")
  autoApproveOverrideReason String?          @map("auto_approve_override_reason")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")

  // Relations
  task     Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  child    User           @relation("AssignedTasks", fields: [childId], references: [id], onDelete: Cascade)
  approver User?          @relation("ApprovedAssignments", fields: [approvedBy], references: [id])
  evidence TaskEvidence[]
  comments TaskComment[]

  @@unique([taskId, childId, instanceDate])
  @@index([taskId])
  @@index([childId])
  @@index([status])
  @@index([instanceDate])
  // M9 - index for the expiry cron so it can efficiently find un-emailed assignments
  @@index([emailSentAt])
  @@map("task_assignments")
}

// FR-11: short comments between a parent and child on a specific assignment.
model TaskComment {
  id           String   @id @default(uuid())
  assignmentId String   @map("assignment_id")
  authorId     String   @map("author_id")
  content      String
  createdAt    DateTime @default(now()) @map("created_at")

  assignment TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([authorId])
  @@map("task_comments")
}

model TaskEvidence {
  id               String           @id @default(uuid())
  assignmentId     String           @map("assignment_id")
  evidenceType     EvidenceType
  fileUrl          String?          @map("file_url")
  fileKey          String?          @map("file_key")
  thumbnailKey     String?          @map("thumbnail_key")
  fileSizeBytes    Int?             @map("file_size_bytes")
  mimeType         String?          @map("mime_type")
  thumbnailUrl     String?          @map("thumbnail_url")
  note             String?
  moderationStatus ModerationStatus @default(pending) @map("moderation_status")
  uploadedAt       DateTime         @default(now()) @map("uploaded_at")

  // Relations
  assignment TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("task_evidence")
}

// ============================================
// POINTS & REWARDS
// ============================================

model PointsLedger {
  id              String          @id @default(uuid())
  childId         String          @map("child_id")
  transactionType TransactionType @map("transaction_type")
  pointsAmount    Int             @map("points_amount")
  balanceAfter    Int             @map("balance_after")
  referenceType   String?         @map("reference_type")
  referenceId     String?         @map("reference_id")
  description     String?
  breakdown       Json?
  createdBy       String?         @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")

  // Relations
  child   User  @relation("ChildPoints", fields: [childId], references: [id], onDelete: Cascade)
  creator User? @relation("CreatedPointsEntries", fields: [createdBy], references: [id])

  @@index([childId])
  @@index([createdAt])
  @@index([transactionType])
  @@map("points_ledger")
}

model Reward {
  id                       String      @id @default(uuid())
  familyId                 String      @map("family_id")
  createdBy                String      @map("created_by")
  name                     String
  description              String?
  pointsCost               Int         @map("points_cost")
  tier                     RewardTier?
  iconUrl                  String?     @map("icon_url")
  isActive                 Boolean     @default(true) @map("is_active")
  maxRedemptionsPerChild   Int?        @map("max_redemptions_per_child")
  // M6 - CR-11: household-level redemption cap (total across all children)
  maxRedemptionsTotal      Int?        @map("max_redemptions_total")
  expiresAt                DateTime?   @map("expires_at")
  isCollaborative          Boolean     @default(false) @map("is_collaborative")
  // FR-09: set once the pooled contributions first reach pointsCost, so auto-fulfilment fires once.
  collaborativeFulfilledAt DateTime?   @map("collaborative_fulfilled_at")
  /// Who ends up with a funded collaborative reward: 'shared' (the family — the default, because
  /// most such rewards are a film night or a day out) or 'parent_choice' (a parent designates one
  /// child, for rewards only one person can actually have).
  /// Deliberately NOT last-contributor-wins: that rewards timing over effort and pushes children to
  /// withhold points and snipe the final few.
  recipientRule            String      @default("shared") @map("recipient_rule")
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")
  deletedAt                DateTime?   @map("deleted_at")

  // Relations
  family        Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator       User                 @relation(fields: [createdBy], references: [id])
  redemptions   RewardRedemption[]
  contributions RewardContribution[]
  wishlists     RewardWishlist[]

  @@index([familyId])
  @@index([isActive])
  @@index([tier])
  @@map("rewards")
}

model RewardRedemption {
  id               String           @id @default(uuid())
  rewardId         String           @map("reward_id")
  childId          String           @map("child_id")
  pointsSpent      Int              @map("points_spent")
  status           RedemptionStatus @default(pending)
  approvedBy       String?          @map("approved_by")
  approvedAt       DateTime?        @map("approved_at")
  fulfilledAt      DateTime?        @map("fulfilled_at")
  /// Set only when a collaborative reward's rule is 'parent_choice'. NULL means shared — nobody
  /// individually received it — which is also the case for every solo redemption.
  recipientChildId String?          @map("recipient_child_id")
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")

  // Relations
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  child  User   @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([rewardId])
  @@index([childId])
  @@index([status])
  @@map("reward_redemptions")
}

// FR-09: collaborative rewards — children pool points toward one shared reward. Each row is one
// child's contribution; the reward auto-fulfils when the sum reaches pointsCost.
model RewardContribution {
  id        String   @id @default(uuid())
  rewardId  String   @map("reward_id")
  childId   String   @map("child_id")
  points    Int
  createdAt DateTime @default(now()) @map("created_at")

  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  child  User   @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([rewardId])
  @@index([childId])
  @@map("reward_contributions")
}

// FR-14: reward wishlist — a child stars a reward so parents can see what motivates whom.
model RewardWishlist {
  id        String   @id @default(uuid())
  rewardId  String   @map("reward_id")
  childId   String   @map("child_id")
  /// The one wishlist item the child has pinned as their goal (growth roadmap §4.2).
  /// At most one per child; enforced in GoalService, not by a constraint, because "at most one true
  /// per child" is not expressible as a unique index.
  isGoal    Boolean  @default(false) @map("is_goal")
  createdAt DateTime @default(now()) @map("created_at")

  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  child  User   @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([rewardId, childId])
  @@index([rewardId])
  @@index([childId])
  @@map("reward_wishlists")
}

// ============================================
// GAMIFICATION
// ============================================

model Achievement {
  id                   String           @id @default(uuid())
  name                 String
  description          String?
  iconUrl              String?          @map("icon_url")
  category             String?
  unlockCriteriaType   String?          @map("unlock_criteria_type")
  unlockCriteriaValue  Int?             @map("unlock_criteria_value")
  unlockCriteriaConfig Json?            @map("unlock_criteria_config")
  tier                 AchievementTier?
  isSystemAchievement  Boolean          @default(true) @map("is_system_achievement")
  pointsReward         Int              @default(0) @map("points_reward")
  xpReward             Int              @default(0) @map("xp_reward")
  // M10 - Phase 4: minimum XP level required to unlock (used in R-05 level distribution)
  xpThreshold          Int              @default(0) @map("xp_threshold")
  createdAt            DateTime         @default(now()) @map("created_at")

  // Relations
  childAchievements ChildAchievement[]

  @@index([category])
  @@index([tier])
  @@map("achievements")
}

model ChildAchievement {
  id            String   @id @default(uuid())
  childId       String   @map("child_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")
  progressValue Int?     @map("progress_value")

  // Relations
  child       User        @relation(fields: [childId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([childId, achievementId])
  @@index([childId])
  @@index([unlockedAt])
  @@map("child_achievements")
}

model DailyChallenge {
  id            String   @id @default(uuid())
  familyId      String   @map("family_id")
  challengeDate DateTime @map("challenge_date") @db.Date
  title         String
  description   String?
  challengeType String?  @map("challenge_type")
  criteria      Json?
  bonusPoints   Int      @map("bonus_points")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  family      Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  completions ChallengeCompletion[]

  @@unique([familyId, challengeDate])
  @@index([familyId])
  @@index([challengeDate])
  @@map("daily_challenges")
}

model ChallengeCompletion {
  id                 String   @id @default(uuid())
  challengeId        String   @map("challenge_id")
  childId            String   @map("child_id")
  completedAt        DateTime @default(now()) @map("completed_at")
  bonusPointsAwarded Int?     @map("bonus_points_awarded")

  // Relations
  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  child     User           @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([challengeId, childId])
  @@index([challengeId])
  @@index([childId])
  @@map("challenge_completions")
}

// ============================================
// NOTIFICATIONS & SETTINGS
// ============================================

model Notification {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  notificationType String    @map("notification_type")
  title            String
  message          String
  actionUrl        String?   @map("action_url")
  referenceType    String?   @map("reference_type")
  referenceId      String?   @map("reference_id")
  isRead           Boolean   @default(false) @map("is_read")
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite index: covers WHERE userId=X (AND isRead=Y) ORDER BY createdAt DESC
  // Replaces 3 separate single-column indexes which forced the DB to pick just one.
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model FamilySettings {
  id                        String   @id @default(uuid())
  familyId                  String   @unique @map("family_id")
  autoApproveRecurringTasks Boolean  @default(false) @map("auto_approve_recurring_tasks")
  // PE - daily cap on points a child can earn through mini-games
  maxGamePointsPerDay       Int      @default(100) @map("max_game_points_per_day")
  // PD - configurable thresholds for time-based auto-approve override
  autoApproveMinRatio       Float    @default(0.3) @map("auto_approve_min_ratio")
  autoApproveMaxRatio       Float    @default(3.0) @map("auto_approve_max_ratio")
  enableDailyChallenges     Boolean  @default(true) @map("enable_daily_challenges")
  enableLeaderboard         Boolean  @default(false) @map("enable_leaderboard")
  streakGracePeriodHours    Int      @default(4) @map("streak_grace_period_hours")
  // M9 - CR-08: per-family email notification preferences.
  // Keys: task_submitted | task_approved | task_rejected | task_expiring | task_expired |
  //       reward_redeemed | level_up | streak_at_risk | welcome | co_parent_invite
  // Default: all enabled. Individual parents can override per-key via PUT /families/me/settings.
  notificationPreferences   Json     @default("{\"task_submitted\":true,\"task_approved\":true,\"task_rejected\":true,\"task_expiring\":true,\"task_expired\":true,\"reward_redeemed\":true,\"level_up\":true,\"streak_at_risk\":true,\"welcome\":true,\"co_parent_invite\":true}") @map("notification_preferences")
  /// Wizard progress (growth roadmap §3.2). Null until the parent starts it; holds completed step
  /// ids and a dismissed flag, so the checklist survives logout and can be resumed or skipped.
  onboardingState           Json?    @map("onboarding_state")
  theme                     String   @default("default")
  language                  String   @default("en")
  timezone                  String   @default("UTC")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  // Relations
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("family_settings")
}

// ============================================
// CO-PARENT INVITATIONS (M4)
// ============================================

model FamilyInvitation {
  id              String    @id @default(uuid())
  familyId        String    @map("family_id")
  invitedByUserId String    @map("invited_by_user_id")
  email           String
  token           String    @unique
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  // M10 - Phase 4: R-08 tracks co-parent invite acceptance rate
  cancelledAt     DateTime? @map("cancelled_at")
  relationship    String? // e.g. "spouse", "partner", "guardian"
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("SentInvitations", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([token])
  @@index([email])
  @@map("family_invitations")
}

// ============================================
// M8 - ADMIN & AUDIT
// ============================================

/**
 * AuditLog - immutable record of every mutating action in the system.
 * Written by AuditService.logAction() from all mutating routes.
 * Never updated or deleted - admin can only read and export.
 * action examples    : CREATE | UPDATE | DELETE | APPROVE | REJECT |
 * REDEEM | FULFILL | SUSPEND | REACTIVATE | LOGIN |
 * REGISTER | INVITE_SENT | INVITE_ACCEPTED | FORCE_RESET
 * resourceType examples: task | task_assignment | reward | reward_redemption |
 * family | user | child | invitation | achievement
 * metadata           : arbitrary JSON snapshot - e.g. { before, after } for
 * updates, or { reason } for suspensions.
 */
model AuditLog {
  id           String   @id @default(uuid())
  // The user who performed the action (null for system/cron actions)
  actorId      String?  @map("actor_id")
  // Human-readable action verb (see examples above)
  action       String
  // The type of resource affected
  resourceType String   @map("resource_type")
  // The ID of the affected resource
  resourceId   String   @map("resource_id")
  // Optional family scope - null for cross-family admin actions
  familyId     String?  @map("family_id")
  // Optional JSON payload: before/after state, extra context
  metadata     Json?
  // IP address of the actor (for security audit purposes)
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([resourceType])
  @@index([resourceId])
  @@index([familyId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// M9 - EMAIL LOGS
// ============================================

/**
 * EmailLog - immutable record of every email attempt made by EmailService.
 * EmailService writes a row here for every send attempt whether it succeeds
 * or fails. The admin email log viewer reads this table.
 * triggerType mirrors the notificationPreferences keys so the opt-out check
 * can reference the same string:
 * task_submitted | task_approved | task_rejected | task_expiring |
 * task_expired   | reward_redeemed | level_up | streak_at_risk |
 * welcome        | co_parent_invite
 * status:
 * sent    - SMTP accepted the message (no bounce detected yet)
 * failed  - SMTP threw an error; errorMessage has details
 * bounced - future use via webhook (not implemented in M9)
 */
model EmailLog {
  id            String         @id @default(uuid())
  // Recipient email address (denormalised - user may be deleted later)
  toEmail       String         @map("to_email")
  // The user this email was sent to (null if family-level send or user deleted)
  toUserId      String?        @map("to_user_id")
  toUser        User?          @relation("ReceivedEmails", fields: [toUserId], references: [id], onDelete: SetNull)
  family        Family?        @relation(fields: [familyId], references: [id], onDelete: SetNull)
  // Family scope - null for admin-triggered emails
  familyId      String?        @map("family_id")
  // Which template / notification type triggered this email
  triggerType   String         @map("trigger_type")
  // Email subject line (stored for the admin resend UI)
  subject       String
  // Delivery outcome
  status        EmailLogStatus @default(sent)
  // Populated when status = failed
  errorMessage  String?        @map("error_message")
  // The resource that triggered this email (e.g. assignment id, redemption id)
  referenceType String?        @map("reference_type")
  referenceId   String?        @map("reference_id")
  // M9 - admin resend: tracks how many times this specific log entry was re-sent
  resendCount   Int            @default(0) @map("resend_count")
  lastResentAt  DateTime?      @map("last_resent_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([toUserId])
  @@index([familyId])
  @@index([triggerType])
  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}

// ============================================
// PUSH NOTIFICATIONS
// ============================================

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dhKey String   @map("p256dh_key")
  authKey   String   @map("auth_key")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================
// OUTBOUND WEBHOOKS (FR-18)
// ============================================

// A family-owned HTTPS endpoint that receives a signed POST whenever a subscribed notification
// event fires. See services/WebhookService.ts for the SSRF policy and the signing recipe.
model WebhookSubscription {
  id       String   @id @default(uuid())
  familyId String   @map("family_id")
  // Always https:// and always resolved to a public unicast address (validated on create AND
  // re-validated immediately before every delivery — DNS rebinding defence).
  url      String
  // Canonical notification types this endpoint wants. See WEBHOOK_EVENTS in @taskbuddy/shared.
  events   String[]
  // HMAC-SHA256 signing key. Stored AES-256-GCM-encrypted when MFA_ENCRYPTION_KEY is configured
  // (same `iv:tag:ciphertext` envelope as User.mfaSecret), otherwise as the raw hex string.
  // Never returned by the list endpoint — only by the explicit reveal endpoint.
  secret   String
  isActive Boolean  @default(true) @map("is_active")

  // Consecutive delivery failures. Reset to 0 on any success; at the auto-disable threshold the
  // subscription flips isActive=false and the family's parents get a notification.
  failureCount   Int       @default(0) @map("failure_count")
  lastFailureAt  DateTime? @map("last_failure_at")
  lastSuccessAt  DateTime? @map("last_success_at")
  disabledAt     DateTime? @map("disabled_at")
  // Bounded ring buffer (newest first, capped in code) of the last few failures so the parent UI
  // can show "recent failures" without an unbounded, prune-me-later delivery-log table.
  // Shape: [{ at: ISO string, event: string, reason: string, status?: number }]
  recentFailures Json      @default("[]") @map("recent_failures")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([isActive])
  @@map("webhook_subscriptions")
}

// ============================================
// MINI GAMES
// ============================================

model GameDefinition {
  id                  String         @id @default(uuid())
  type                String // 'quiz' | 'crossword' | 'puzzle' — the FORMAT, not the subject
  title               String
  description         String?
  /// Subject axis the child picks. `puzzle` is a category here, not a format.
  category            GameCategory
  /// Difficulty axis the child picks. Freely selectable at any age; appropriateness lives in content.
  level               GameLevel
  /// Legacy difficulty. Superseded by `level` (backfilled from it) and still exposed by the admin API
  /// for continuity. Nothing reads it for gameplay any more.
  difficulty          TaskDifficulty @default(easy)
  /// Display-only. The award path reads GAME_REWARDS[level] from shared, so an admin typo here cannot
  /// break the points economy. Backfilled to match the level.
  pointsReward        Int            @default(20) @map("points_reward")
  /// Display-only, same reasoning as pointsReward.
  xpReward            Int            @default(10) @map("xp_reward")
  /// Display-only. Cooldown is now scoped to the CATEGORY and its duration comes from
  /// GAME_COOLDOWN_HOURS in shared — completing any game in a category times out the whole category.
  cooldownHours       Int            @default(24) @map("cooldown_hours")
  ageGroup            String?        @map("age_group") // '10-12' | '13-16' | null = all ages
  // The question BANK as JSON - answers included here (never sent to client).
  // Each session draws questionsPerSession from it, so the bank is normally much larger.
  questionsJson       Json           @map("questions_json")
  // How many questions one play serves. The daily draw rotates which ones, so a bank of 25 and a
  // draw of 5 gives a different quiz each day instead of the same five forever.
  questionsPerSession Int            @default(5) @map("questions_per_session")
  isActive            Boolean        @default(true) @map("is_active")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  sessions GameSession[]
  seen     GameQuestionSeen[]

  @@index([type])
  @@index([isActive])
  /// The child-facing picker queries by both axes.
  @@index([category, level, isActive])
  @@map("game_definitions")
}

/// One row per (child, question) the child has actually been graded on.
///
/// This is the rotation index. `selectQuestionsForChild()` draws from the bank MINUS these rows, so a
/// child never sees a question twice until they have seen them all — then it recycles the
/// least-recently-seen, which is why a child can never dead-end on an exhausted bank.
///
/// It deliberately overlaps a little with `GameSession.answersJson`: that stays the authoritative
/// in-session record (the answer-locking depends on it), while this table is an indexable
/// per-(child, question) view. Deriving the rotation from JSON scans across every past session works
/// and then gets slow. It is also exactly the shape the per-answer parent report wants.
///
/// Written at SUBMIT, not when questions are served — so abandoning a session does not burn questions,
/// and `wasCorrect` is known. Seeing questions without answering reveals nothing, because feedback is
/// only returned once an answer is locked.
model GameQuestionSeen {
  id               String   @id @default(uuid())
  childId          String   @map("child_id")
  gameDefinitionId String   @map("game_definition_id")
  /// Question id from the definition's bank (e.g. `m01`). Not a foreign key — the bank is JSON.
  questionId       String   @map("question_id")
  seenAt           DateTime @default(now()) @map("seen_at")
  wasCorrect       Boolean  @map("was_correct")

  child          User           @relation(fields: [childId], references: [id], onDelete: Cascade)
  gameDefinition GameDefinition @relation(fields: [gameDefinitionId], references: [id], onDelete: Cascade)

  @@unique([childId, gameDefinitionId, questionId])
  /// Drives the "least-recently-seen first" recycle order.
  @@index([childId, gameDefinitionId, seenAt])
  @@map("game_question_seen")
}

model GameSession {
  id                  String            @id @default(uuid())
  childId             String            @map("child_id")
  gameDefinitionId    String            @map("game_definition_id")
  startedAt           DateTime          @default(now()) @map("started_at")
  submittedAt         DateTime?         @map("submitted_at")
  expiresAt           DateTime          @map("expires_at")
  status              GameSessionStatus @default(in_progress)
  pointsAwarded       Int               @default(0) @map("points_awarded")
  xpAwarded           Int               @default(0) @map("xp_awarded")
  // SHA-256 of the correct answer array - never returned to client.
  // Retained for sessions created before per-question grading; new sessions grade from answersJson.
  solutionHash        String            @map("solution_hash")
  // Per-question answers, locked one at a time via POST /sessions/:id/answer.
  // Array of length questionCount; null = not yet answered. The lock is what stops a child
  // probing the reveal endpoint once per option to find the correct one before committing.
  answersJson         Json?             @map("answers_json")
  // Snapshot of the questions this session actually served, taken at creation.
  // Deliberately a copy rather than a reference: an admin editing the bank mid-session would
  // otherwise shift the question order and silently misalign answersJson.
  servedQuestionsJson Json?             @map("served_questions_json")
  createdAt           DateTime          @default(now()) @map("created_at")

  child          User           @relation(fields: [childId], references: [id], onDelete: Cascade)
  gameDefinition GameDefinition @relation(fields: [gameDefinitionId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([gameDefinitionId])
  @@index([status])
  @@map("game_sessions")
}

// One row per issued refresh token. Enables rotation (each refresh mints a new row in the same
// chain and revokes the old one), reuse detection (a replayed/rotated token kills its whole
// chain), and revocation (logout, password change/reset, admin action, child PIN reset). The
// raw JWT is never stored — only its sha256, and the row id is the token's jti claim.
model RefreshSession {
  id                String    @id // = the jwt `jti` claim
  userId            String    @map("user_id")
  tokenHash         String    @unique @map("token_hash") // sha256 hex of the refresh JWT
  chainId           String    @map("chain_id") // rotation family; constant across rotations
  expiresAt         DateTime  @map("expires_at") // natural expiry (mirrors the JWT exp)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") // hard cap for the whole chain
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason") // logout|rotated|reuse|expired|password_change|admin|pin_reset
  replacedById      String?   @map("replaced_by_id")
  createdByIp       String?   @map("created_by_ip")
  userAgent         String?   @map("user_agent")
  deviceId          String?   @map("device_id") // F-10g: opaque client device id, traceability only
  client            String? // P0-4: X-Client value, e.g. taskbuddy-android/1.0.0; NULL = web
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chainId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  parent
  child
  admin
}

enum AgeGroup {
  YOUNGER @map("10-12")
  OLDER   @map("13-16")
}

enum TaskDifficulty {
  easy
  medium
  hard
}

// M5 - CR-01: task classification
enum TaskTag {
  primary // Must-do task assigned by parent
  secondary // Bonus/optional task; child can self-assign if no primary is pending
}

enum TaskStatus {
  active
  paused
  archived
}

enum AssignmentStatus {
  pending
  in_progress
  completed
  approved
  rejected
  expired
}

enum TransactionType {
  earned
  redeemed
  bonus
  penalty
  adjustment
  // M7 - CR-06: awarded when child levels up or hits a streak milestone
  milestone_bonus
  // PE - awarded when child completes a mini-game
  game_reward
}

enum GameSessionStatus {
  in_progress
  completed
  failed
  expired
}

/// Subject axis for games. Mirrors GAME_CATEGORIES in shared/src/constants/games.ts — keep in sync.
enum GameCategory {
  maths
  science
  geography
  vocabulary
  grammar
  puzzle
}

/// Difficulty axis for games. Mirrors GAME_LEVELS in shared/src/constants/games.ts — keep in sync.
enum GameLevel {
  beginner
  intermediate
  hard
}

enum RewardTier {
  small
  medium
  large
}

enum AchievementTier {
  bronze
  silver
  gold
  platinum
}

enum RedemptionStatus {
  pending
  approved
  fulfilled
  cancelled
}

enum EvidenceType {
  photo
  note
  video
}

enum ModerationStatus {
  pending
  approved
  flagged
  rejected
}

// M9 - email delivery status
enum EmailLogStatus {
  sent
  failed
  bounced
}

/// Funnel instrumentation (growth roadmap 0b).
///
/// Deliberately NOT joined to Family with a foreign key. Two reasons: pre-signup events (a
/// registration that fails validation) have no family yet, and the retention purge hard-deletes
/// families — a cascade would erase the very funnel history the metrics are computed from. The
/// familyId is a loose reference, and events are purged on their own age-based schedule instead.
///
/// PII NEVER goes in `payload`. AnalyticsService strips anything email-shaped or free-text before
/// writing; callers pass ids and enums only. Binding per the child-data guardrails.
model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String   @map("event_type")
  /// Loose reference; no FK, and null for pre-signup events.
  familyId  String?  @map("family_id")
  /// 'parent' | 'child' | 'admin' | 'system'
  actorRole String?  @map("actor_role")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([familyId, createdAt])
  @@map("analytics_events")
}

/// COPPA verifiable parental consent (growth roadmap §3.2 / §2.1).
///
/// Distinct from the `CONSENT` AuditLog events, which record that ToS/privacy terms were accepted.
/// COPPA additionally requires a verification METHOD and requires child data collection to be
/// blocked until verification completes — that is what this table gates.
///
/// One row per family: consent is given by a parent on behalf of the family's children, and
/// re-consent replaces rather than accumulates (superseded rows are revoked).
model ParentalConsent {
  id             String    @id @default(uuid())
  familyId       String    @unique @map("family_id")
  /// The parent who gave it. Kept even if they later leave, for the audit trail.
  parentId       String    @map("parent_id")
  /// Registered method id, e.g. 'email_plus'. Stored so a later stricter method is distinguishable.
  method         String
  /// 'pending' | 'verified' | 'revoked'
  status         String    @default("pending")
  /// SHA-256 of the verification token. The raw token only ever exists in the email.
  tokenHash      String?   @map("token_hash")
  /// Consent that is never completed must not sit pending forever.
  expiresAt      DateTime? @map("expires_at")
  requestedAt    DateTime  @default(now()) @map("requested_at")
  verifiedAt     DateTime? @map("verified_at")
  /// Recorded at verification — COPPA expects a record of who consented and from where.
  ipAddress      String?   @map("ip_address")
  tosVersion     String    @map("tos_version")
  privacyVersion String    @map("privacy_version")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("parental_consents")
}

/// Avatar cosmetics (growth roadmap §4.4).
///
/// A points SINK. Rewards depend on a parent actually delivering something in the real world; when
/// they are slow, points stop meaning anything and the loop stalls. Cosmetics give points value the
/// child controls entirely.
///
/// Everything is bought with in-app points earned from tasks. There is NO purchase path in the child
/// experience — binding under the ethics guardrails.
model CosmeticItem {
  id          String   @id @default(uuid())
  /// 'frame' | 'background' | 'hat'. One item may be equipped per category.
  category    String
  name        String
  description String?
  /// Renderer key the frontend maps to CSS/SVG. Keeps art out of the database.
  assetKey    String   @map("asset_key")
  pointsCost  Int      @map("points_cost")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owners ChildCosmetic[]

  @@unique([category, assetKey])
  @@index([category])
  @@map("cosmetic_items")
}

/// Ownership, and separately whether it is currently worn.
/// Owning is permanent — a child never loses something they paid for.
model ChildCosmetic {
  id          String   @id @default(uuid())
  childId     String   @map("child_id")
  itemId      String   @map("item_id")
  /// At most one true per (child, category); enforced in CosmeticService, since that is not
  /// expressible as a unique index.
  isEquipped  Boolean  @default(false) @map("is_equipped")
  purchasedAt DateTime @default(now()) @map("purchased_at")

  child User         @relation(fields: [childId], references: [id], onDelete: Cascade)
  item  CosmeticItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([childId, itemId])
  @@index([childId, isEquipped])
  @@map("child_cosmetics")
}

/// A person recruited for the Play closed test (Phase 1 exit criterion).
///
/// Deliberately NOT a `User`. A tester is a person the owner is tracking through a recruitment and
/// engagement process; they may never sign up, may sign up weeks later, or may sign up with a
/// different address. Modelling them as a User would mean creating accounts for people who have not
/// consented to one, and would put unverified rows in the table that authentication trusts.
///
/// The link to an actual account is therefore resolved by EMAIL, lazily, and stored once found —
/// see `userId`. A null `userId` means "has not signed up with this address (yet)", which is exactly
/// the state the closed-test roster needs to make visible.
///
/// ⚠️ This holds personal data about ADULTS who are not TaskBuddy users, which PRIVACY.md does not
/// currently describe. It needs a paragraph there before the roster is populated with real people.
model Tester {
  id        String  @id @default(uuid())
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  /// Unique: the address is the join key to `users`, so two rows for one address would make the
  /// activity view ambiguous.
  email     String  @unique
  /// Optional and, at the time of writing, unused — nothing in this stack sends SMS. Kept nullable
  /// rather than required so a roster can be complete without collecting a number that has no
  /// purpose; collecting personal data with no use is the weakest position under GDPR.
  phone     String?

  /// Where they are in the recruitment funnel. Not derived from `userId`, because "invited" and
  /// "declined" are facts about the conversation, not about the database.
  status TesterStatus @default(invited)

  /// Set to the matching `users.id` once someone signs up with this email. Nullable forever if they
  /// never do. `onDelete: SetNull` so deleting a user account does not delete the recruitment record.
  /// `@unique` because this is one-to-one: an account belongs to at most one roster entry. Postgres
  /// treats NULLs as distinct, so any number of not-yet-signed-up testers coexist under the index —
  /// the same property the child-username index relies on.
  userId String? @unique @map("user_id")

  /// When the invite email was last sent, and the reminder. Separate columns because "never invited"
  /// and "invited but not reminded" are different states the admin screen has to distinguish.
  invitedAt      DateTime? @map("invited_at")
  lastRemindedAt DateTime? @map("last_reminded_at")

  /// Free-text, for the owner. e.g. "cousin, Android 12, said he'd start Monday".
  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("testers")
}

enum TesterStatus {
  /// On the roster; no invite sent yet.
  invited
  /// Invite email sent, waiting for them to opt in on Play.
  opted_in
  /// Confirmed opted in on the Play track — the state that counts toward the 12-tester requirement.
  active
  /// Said no, or went quiet. Kept rather than deleted so the roster remembers who was asked.
  declined
}

/// A child who has reached AGE_LIMITS.ADULT_MIN and is awaiting their parent's decision.
///
/// One row per aging-out event, created by the daily job and resolved either by a parent or by the
/// deadline. Kept as its own table rather than as flags on User for two reasons: the decision has
/// several fields that are meaningless for everyone else, and the row is an audit record of what was
/// chosen and when — deleting the child later must not erase that a choice was made.
model AccountTransition {
  id       String @id @default(uuid())
  familyId String @map("family_id")
  /// The child who turned 18. Unique: a person ages out once.
  childId  String @unique @map("child_id")

  /// pending | resolved | expired. `expired` means the deadline applied the default.
  status            String  @default("pending")
  /// transfer | discard | invite — null while pending.
  decision          String?
  /// Set only for `transfer`. The sibling the points went to.
  transferToChildId String? @map("transfer_to_child_id")
  /// Snapshot of the balance at detection, so the record still reads correctly after the transfer.
  pointsAtDetection Int     @default(0) @map("points_at_detection")

  detectedAt DateTime  @default(now()) @map("detected_at")
  /// detectedAt + TRANSITION_DEADLINE_DAYS. After this the default applies.
  deadlineAt DateTime  @map("deadline_at")
  resolvedAt DateTime? @map("resolved_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// ⚠️ NOT onDelete: Cascade on the child. Removing a child must not delete the record of what was
  /// decided about their points — that is the one thing a parent may need to look back at.
  child  User   @relation("TransitionChild", fields: [childId], references: [id])

  @@index([status, deadlineAt])
  @@map("account_transitions")
}

/// An Expo push token for one installed app on one device.
///
/// Separate from PushSubscription rather than folded into it: web push is a VAPID endpoint plus two
/// keys, Expo push is a single opaque token sent to Expo's service. Sharing one table would mean a
/// row where three of five columns are always null and a `kind` discriminator every query has to
/// remember.
model ExpoPushToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  /// `ExponentPushToken[...]`. Unique because Expo issues one per install: the same token arriving
  /// again is the same device re-registering, not a second device.
  token      String   @unique
  platform   String   @default("android")
  createdAt  DateTime @default(now()) @map("created_at")
  /// Refreshed on every registration so dead installs can be pruned later.
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("expo_push_tokens")
}
