{
  "name": "@taskbuddy/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "eslint app src --ext .ts,.tsx",
    "lint:fix": "eslint app src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.0",
    "zustand": "^5.0.14"
  },
  "expo": {
    "install": {
      "//": "typescript is deliberately held at the monorepo's 5.9.x rather than the SDK 57 default of 6.0.x. Backend and frontend both build with 5.9, and npm hoists one copy; letting expo install 6.0 here would put a different major in front of `tsc -b` for the whole repo. Revisit when backend and frontend move to TypeScript 6.",
      "exclude": [
        "typescript"
      ]
    }
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.4",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "typescript": "~5.9.3"
  }
}
